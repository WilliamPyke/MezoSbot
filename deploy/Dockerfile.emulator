FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/bot/package.json apps/bot/package.json
COPY apps/emulator/package.json apps/emulator/package.json
COPY apps/games-worker/package.json apps/games-worker/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/game-core/package.json packages/game-core/package.json
# The emulator only needs pure-JS deps (serverboy, ws, supabase). Skipping
# install scripts avoids building unused native packages (@koush/wrtc) on Node 22.
RUN npm ci --ignore-scripts
COPY tsconfig.base.json ./
COPY apps/emulator ./apps/emulator
COPY packages ./packages
COPY src/emulator.ts src/emulatorRuntime.ts ./src/
RUN npm run build:packages && npm run build:emulator
RUN npm prune --omit=dev --ignore-scripts

FROM node:22-bookworm-slim
# The ROM is NOT baked into the image: mount it at ROM_PATH at runtime
# (Northflank secret file or volume). GB_SAVES_DIR is the local fallback used
# only when the Supabase save upsert fails.
ENV NODE_ENV=production GB_DEFER_ROUND_APPLY=1 ROM_PATH=/app/pokeyellow.gbc GB_SAVES_DIR=/app/saves
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
# apps/emulator/package.json ("type": "module") and the generated
# dist/src/package.json ("type": "commonjs") decide how Node loads each file.
COPY --from=build /app/apps/emulator/package.json ./apps/emulator/package.json
COPY --from=build /app/apps/emulator/dist ./apps/emulator/dist
COPY --from=build /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=build /app/packages/contracts/package.json ./packages/contracts/package.json
RUN mkdir -p /app/saves && chown node:node /app/saves
USER node
EXPOSE 8787
CMD ["node", "apps/emulator/dist/apps/emulator/src/index.js"]
