# ============================================================================
# MANUALLY ADD TO RENDER DASHBOARD - SECRETS (copy these to Render Environment)
# ============================================================================

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
ADMIN_IDS=your_discord_user_id,another_admin_id
# Optional privileged gateway intent. Leave false unless enabled in Discord Developer Portal.
DISCORD_GUILD_MEMBERS_INTENT=false
# Optional privileged gateway intent for typed Pokemon controls and rain banned-word filtering.
# Leave false unless enabled in Discord Developer Portal.
DISCORD_MESSAGE_CONTENT_INTENT=false

# Delete duplicate target-link posts in quest channels for N minutes after a window is claimed (0 = off).
QUEST_LINK_DUPLICATE_DELETE_MINUTES=5

# Optional bootstrap for transaction ledger channel (prefer /admin → Ledger)
LEDGER_GUILD_ID=
LEDGER_CHANNEL_ID=

# Supabase Database
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# EVM / Blockchain Configuration
RPC_URL=https://rpc.mezo.org
CHAIN_ID=31612
TOKEN_CONTRACT=0xYourTokenContractAddress
TOKEN_DECIMALS=18
# Optional overrides for the built-in Mezo mainnet token configuration.
MUSD_TOKEN_CONTRACT=0xdD468A1DDc392dcdbEf6db6e34E89AA338F9F186
MUSD_TOKEN_DECIMALS=18
MEZO_TOKEN_CONTRACT=0x7B7c000000000000000000000000000000000001
MEZO_TOKEN_DECIMALS=18
MUSDC_TOKEN_CONTRACT=0x04671C72Aab5AC02A03c1098314b1BB6B560c197
MUSDC_TOKEN_DECIMALS=6
TREASURY_PRIVATE_KEY=0xYourPrivateKeyHere
# Dedicated hot wallet used only to fund deposit-address ERC-20 sweep gas.
# Strongly recommended before setting DEPOSIT_ADMIN_ONLY=false.
SWEEP_GAS_SPONSOR_PRIVATE_KEY=0xYourSweepGasSponsorPrivateKeyHere
PROTOCOL_GAS_RESERVE_MIN_SATS=1000
EXPLORER_URL=https://explorer.mezo.org

# imgnAI Katana image generation (MUSD x402 on Mezo mainnet)
IMGNAI_BASE_URL=https://kat.imgnai.com
IMGNAI_X402_TARGET_MUSD=1.00
IMGNAI_MODEL_CACHE_MS=300000
IMGNAI_IMAGE_TIMEOUT_MS=600000
IMGNAI_PROMPT_MAX_LENGTH=2000

# Wallet-first Mallard Arcade
PUBLIC_BASE_URL=https://play.mallard.sh
MEZO_DEFAULT_NETWORK=mainnet
MEZO_MAINNET_RPC_URL=https://rpc-http.mezo.boar.network
MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
ESCROW_MAINNET_CONTRACT_ADDRESS=0xYourMainnetEscrowContractAddress
ESCROW_TESTNET_CONTRACT_ADDRESS=0xYourTestnetEscrowContractAddress
# Backward-compatible fallback for single-network deployments.
ESCROW_CONTRACT_ADDRESS=0xYourDefaultEscrowContractAddress
# Deploy-time only: admin can update fee/treasury/allowlist and grant/revoke roles.
ESCROW_ADMIN_ADDRESS=0xYourEscrowAdminAddress
# Deploy-time only: public address for the backend settlement signer.
ESCROW_SETTLER_ADDRESS=0xYourSettlerWalletAddress
# Runtime secret: private key for ESCROW_SETTLER_ADDRESS.
ESCROW_SETTLER_PRIVATE_KEY=0xYourSettlerPrivateKeyHere
ESCROW_TREASURY_ADDRESS=0xYourTreasuryAddress
ESCROW_PLATFORM_FEE_BPS=1000
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
WEB_SESSION_SECRET=replace_with_a_long_random_secret
WEB_JOIN_WINDOW_SECONDS=900
WEB_PLAY_WINDOW_SECONDS=180
WEB_SETTLEMENT_GRACE_SECONDS=30

# Deposit Configuration
DEPOSIT_WEB_URL=https://deposit.mallard.sh/sbot
DEPOSIT_ADMIN_ONLY=true
DEPOSIT_POLL_MS=60000
DEPOSIT_ADDRESS_REFRESH_MS=900000
ERC20_SWEEP_DELAY_MS=300000
MUSD_MIN_DEPOSIT=0.10
MEZO_MIN_DEPOSIT=1.00
MUSDC_MIN_DEPOSIT=0.10
SKIP_WITHDRAWAL_MIN=false

# Wallet Verification
WALLET_VERIFY_CHALLENGE_SATS=10
WALLET_VERIFY_CHALLENGE_HOURS=24
WALLET_VERIFY_SCAN_BLOCKS=300

# Game Channel (Discord channel ID where users play)
POKEMON_ENABLED=true
POKEMON_TEXT_INPUT_ENABLED=false
GB_CHANNEL_ID=your_discord_channel_id_here

# ============================================================================
# DEFINED IN render.yaml - DO NOT ADD MANUALLY TO RENDER
# (These are set automatically from render.yaml)
# ============================================================================

# Path to Game Boy ROM file
ROM_PATH=./pokeyellow.gbc
# Minimum sats bid per input
GB_MIN_BID=0.001
# Democracy round duration in ms
GB_ROUND_MS=500
# Emulator speed multiplier (1 = real-time, 2 = 2×, 3 = 3×)
# 2× is recommended for good balance of speed and stability
GB_SPEED=2
# Frames to hold a button press
GB_HOLD_FRAMES=16
# Full emulator snapshot interval in ms (default: 5 minutes)
GB_SNAPSHOT_INTERVAL_MS=300000

# Browser Canvas+WebSocket stream settings
# Server starts an HTTP viewer + signaling endpoint on STREAM_PORT/PORT.
# When deploying to Render, omit STREAM_PORT - it will use the PORT env var automatically.
# For local development, you can set STREAM_PORT=8787
# STREAM_PORT=8787
# Fixed 30fps - no auto-tune for rock-solid performance
# Set all three FPS values to same number to disable adaptation
STREAM_TARGET_FPS=30
STREAM_MIN_FPS=30
STREAM_MAX_FPS=30
STREAM_AUTO_TUNE=false
STREAM_VIEWER_SCALE=4
STUN_SERVERS=stun:stun.l.google.com:19302
